{"name":"Gale Crater — Mars Rover Simulator · OPL","short_name":"Gale Crater","description":"Drive a six-wheel rocker-bogie rover across Gale Crater in your browser. Built on real MOLA laser altimetry, with Curiosity's own 4.2 cm/s top speed, its camera suite, and Mount Sharp on the horizon where it actually is.","start_url":"/rover/","scope":"/rover/","display":"fullscreen","orientation":"landscape","background_color":"#0b0705","theme_color":"#0b0705","categories":["education","entertainment","games"],"icons":[{"src":"/rover/brand/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/rover/brand/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/rover/brand/maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}